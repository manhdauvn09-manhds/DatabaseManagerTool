# Node / Next
**/node_modules
**/.next
**/out
**/*.tsbuildinfo

# Env (keep examples)
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.development
!**/.env.example

# Local deploy config (contains server hostnames, ssh key paths)
deploy.config.json

# Local .env templates with generated secrets
deploy/.env.production.template
deploy/.env.production.local

# Logs / OS / IDE
*.log
.DS_Store
.vscode/
.idea/

# Harness Portal ingest key - secret, never commit (C5)
.harness/portal-sync.key

# One-time backup written when a legacy guide block is migrated
*.pre-migration.bak

# Harness runtime state - local per-machine, khong phai source.
# Ledger van tamper-evident nho hash-chain + day len Portal (portal-sync.json);
# commit vao git se churn moi tool call va conflict lien tuc.
.harness/ledger/chain.jsonl
.harness/tmp/
.harness/telemetry/*.jsonl
.harness/telemetry/*.bak
