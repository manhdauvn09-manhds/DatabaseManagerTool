# Node / Next
**/node_modules
**/.next
**/out
**/*.tsbuildinfo

# Env (keep examples)
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.development
!**/.env.example

# Local deploy config (contains server hostnames, ssh key paths)
deploy.config.json

# Local .env templates with generated secrets
deploy/.env.production.template
deploy/.env.production.local

# Logs / OS / IDE
*.log
.DS_Store
.vscode/
.idea/

# Harness Portal ingest key - secret, never commit (C5)
.harness/portal-sync.key

# One-time backup written when a legacy guide block is migrated
*.pre-migration.bak

# Python bytecode cache from harness lib scripts
__pycache__/
*.py[cod]

# Harness runtime state - local per-machine, khong phai source.
# Ledger van tamper-evident nho hash-chain + day len Portal (portal-sync.json);
# commit vao git se churn moi tool call va conflict lien tuc.
.harness/ledger/chain.jsonl
.harness/tmp/
.harness/telemetry/*.jsonl
.harness/telemetry/*.bak

# Harness ledger append lock - runtime state
.harness/ledger/chain.lock

# Shipped copies the installer leaves beside a file you own or edited - resolve, then delete
*.new

# Harness per-machine state (checkout credential, member_email) - never commit
.harness/local/
# Machine-local state (harness machine-state-paths.yaml) -- never commit
.claude/settings.local.json
.harness/telemetry/.push-cursor.json
.harness/telemetry/.push-content.json
.harness/telemetry/.sync-cursor.json
.harness/context/
