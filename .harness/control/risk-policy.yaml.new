# Risk Policy — SSOT for runtime guard decisions
# Guard scripts READ this file; never hardcode rules in .ps1 (C2)
schema_version: "1.0.0"

# Deny patterns for Bash/PowerShell commands
# Each entry: regex pattern matched against the command string
#
# PORTABILITY — both guards read this SSOT, but through different regex engines:
# the PowerShell guard uses .NET `-match`, the bash guard uses POSIX ERE `grep -qE`.
# A pattern that matches in one but not the other makes the bash guard silently
# weaker than the PowerShell guard on every Linux machine. Two rules keep them equal
# (verified by a two-engine harness, not by theory):
#   - No backslash-escape inside a bracket expression. POSIX ERE treats '\' as a
#     literal inside [...], so [^\n] excludes the characters '\' and 'n' (NOT newline)
#     and matches almost nothing an attacker's wildcard needs. Use `.` instead — it
#     means "any char except newline" in BOTH engines (grep is line-oriented; .NET's
#     `.` excludes \n), which is exactly what [^\n] was meant to say.
#   - No pattern may START with '-'. grep reads a leading '-' as an option and the
#     rule never runs (see the -Enc rule: prefixed with `(^|.)` so the string starts
#     with '(' — `(^|.)` = start-of-line OR any one char, so coverage is unchanged).
command_deny_patterns:
  # \\b, not \b: this is a double-quoted YAML scalar, where \b is the BACKSPACE
  # escape. Written with one backslash the pattern silently stops matching
  # anything -- a deny rule that looks present and protects nothing.
  # The boundary itself is here because "rm" with none of it matches inside
  # ordinary words: "confirm -rf /tmp/x" was denied, and a guard that blocks a
  # sentence is a guard people switch off (C14).
  - pattern: "\\brm\\s+-[rR][fF]"
    risk: "critical"
    reason: "Recursive force delete — potential data loss"
    action: "deny"
  - pattern: "sudo\\s+"
    risk: "critical"
    reason: "Privilege escalation — requires approval"
    action: "deny"
  - pattern: "chmod\\s+-R"
    risk: "high"
    reason: "Recursive permission change — potential security bypass"
    action: "deny"
  - pattern: "git\\s+reset\\s+--hard"
    risk: "high"
    reason: "Destructive git reset — loses uncommitted work"
    action: "deny"
  - pattern: "git\\s+push\\s+--force"
    risk: "high"
    reason: "Force push — overwrites remote history"
    action: "deny"
  - pattern: "del\\s+/[FfSs]"
    risk: "critical"
    reason: "Force/silent delete on Windows — potential data loss"
    action: "deny"
  - pattern: "Remove-Item\\s+-Recurse\\s+-Force"
    risk: "critical"
    reason: "Recursive force remove on Windows — potential data loss"
    action: "deny"
  - pattern: "Start-Process\\s+-Verb\\s+RunAs"
    risk: "critical"
    reason: "Elevated execution — privilege escalation"
    action: "deny"
  # --- Remote code execution: pipe-to-shell / decode-to-shell ---
  - pattern: "(curl|wget)\\s+[^|]*\\|\\s*(sudo\\s+)?(ba|z|d)?sh\\b"
    risk: "critical"
    reason: "Piping a download straight into a shell — arbitrary remote code execution"
    action: "deny"
  - pattern: "base64\\s+-{1,2}d[^|]*\\|\\s*(ba|z)?sh\\b"
    risk: "critical"
    reason: "Decoding a blob straight into a shell — obfuscated code execution"
    action: "deny"
  - pattern: "(Invoke-WebRequest|iwr|curl|wget)[^|]*\\|\\s*(iex|Invoke-Expression)"
    risk: "critical"
    reason: "Download piped into Invoke-Expression — remote code execution"
    action: "deny"
  # `(^|.)` prefix keeps the pattern string from starting with '-' (grep-option trap).
  - pattern: "(^|.)-[Ee]nc(odedCommand)?\\s+[A-Za-z0-9+/=]{24,}"
    risk: "critical"
    reason: "PowerShell encoded command — obfuscated execution"
    action: "deny"
  # --- Disk / filesystem destruction ---
  - pattern: "dd\\s+.*of=/dev/"
    risk: "critical"
    reason: "Writing raw to a block device — disk wipe"
    action: "deny"
  - pattern: "\\bmkfs(\\.[a-z0-9]+)?\\b"
    risk: "critical"
    reason: "Formatting a filesystem — data loss"
    action: "deny"
  - pattern: "\\b(wipefs|shred)\\b"
    risk: "critical"
    reason: "Secure-wipe / erase filesystem signatures — data loss"
    action: "deny"
  - pattern: ":\\(\\)\\s*\\{\\s*:\\s*\\|"
    risk: "critical"
    reason: "Fork bomb — resource-exhaustion denial of service"
    action: "deny"
  # --- Permission / ownership weakening ---
  - pattern: "chmod\\s+.*777"
    risk: "high"
    reason: "World-writable permissions — security downgrade"
    action: "deny"
  - pattern: "chown\\s+-R"
    risk: "high"
    reason: "Recursive ownership change — potential privilege issue"
    action: "deny"
  # --- Destructive VCS ---
  - pattern: "git\\s+clean\\s+-[a-zA-Z]*f"
    risk: "high"
    reason: "git clean -f — deletes untracked files irrecoverably"
    action: "deny"
  # --- Audit / defense tampering ---
  - pattern: "history\\s+-c"
    risk: "high"
    reason: "Clearing shell history — anti-forensics"
    action: "deny"
  - pattern: "rm\\s+.*\\.(bash|zsh)_history"
    risk: "high"
    reason: "Deleting shell history — anti-forensics"
    action: "deny"
  - pattern: "(ufw\\s+disable|iptables\\s+-F|systemctl\\s+(stop|disable)\\s+(ufw|fail2ban|firewalld))"
    risk: "critical"
    reason: "Disabling firewall / security service — defense evasion"
    action: "deny"
  # --- Secret exfiltration ---
  - pattern: "(cat|type|Get-Content)\\s+[^|]*(id_rsa|\\.aws[\\\\/]credentials|\\.ssh[\\\\/]id_)"
    risk: "high"
    reason: "Reading private keys / cloud credentials — potential exfiltration"
    action: "deny"
  - pattern: "(\\.env|id_rsa|credentials).*\\|.*(curl|wget|nc)\\b"
    risk: "critical"
    reason: "Piping secrets to the network — credential exfiltration"
    action: "deny"
  # --- Cloud metadata SSRF (v1.2.7) ---
  - pattern: "169\\.254\\.169\\.254"
    risk: "critical"
    reason: "Cloud instance metadata endpoint — IAM credential theft (SSRF)"
    action: "deny"
  # --- Reverse shell ---
  - pattern: "(nc|ncat)\\s+.*-e\\b|/dev/tcp/"
    risk: "critical"
    reason: "Reverse shell (nc -e / bash /dev/tcp) — remote takeover"
    action: "deny"
  # --- Container escape (scoped to `docker run` so compose/build is unaffected) ---
  - pattern: "docker\\s+run.*(--privileged|/var/run/docker\\.sock)"
    risk: "critical"
    reason: "Privileged container / docker.sock mount — host escape"
    action: "deny"
  # --- Setuid escalation (only the setuid mode, not normal chmod 755/644) ---
  - pattern: "chmod\\s+.*(u\\+s|\\b4[0-7]{3}\\b)"
    risk: "high"
    reason: "Setuid bit — privilege-escalation binary"
    action: "deny"
  # --- Rewrite shared git history / anti-forensics ---
  - pattern: "git\\s+filter-repo|git\\s+push.*--mirror"
    risk: "high"
    reason: "History rewrite / mirror push — erases shared-branch evidence"
    action: "deny"
  # --- Tamper the immutable audit ledger (C9) — only destructive verbs ---
  # Same boundary fix, same escaping trap. Without \\b, any sentence containing a
  # word that merely CONTAINS one of these verbs -- "confirm", "model" -- and
  # later mentions the ledger file was denied. That fired four times on prose
  # about this very file during the 2026-08-09 session.
  - pattern: "\\b(rm|del|Remove-Item|truncate|shred)\\b\\s+.*chain\\.jsonl"
    risk: "critical"
    reason: "Deleting/truncating the hash-chain ledger — audit tampering (C9)"
    action: "deny"

# Tool-level deny (matches tool name in tool-registry)
# Used by PreToolUse hook for non-command tools
tool_deny_defaults:
  deploy: { risk: "high", action: "deny", unless_in_workflow: true }
  rollback_deploy: { risk: "high", action: "deny", unless_in_workflow: true }
  mysql_query: { risk: "high", action: "deny", unless_in_workflow: true }
  http_fetch: { risk: "medium", action: "ask" }
  exec_in_container: { risk: "high", action: "deny", unless_in_workflow: true }
  run_command: { risk: "medium", action: "ask" }
