{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness.internal/schemas/workflow.schema.json",
  "title": "Workflow Contract Schema",
  "type": "object",
  "required": ["schema_version", "workflow", "stages"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "workflow": {
      "type": "object",
      "required": ["id", "name", "description", "version"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "agent", "model_profile", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "agent": { "type": "string" },
          "model_profile": { "type": "string", "enum": ["planning", "planning-light", "coding", "review", "summarization"] },
          "description": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "inputs": { "type": "object", "additionalProperties": { "type": "string" } },
          "outputs": { "type": "object", "additionalProperties": { "type": "string" } },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "condition", "description"],
              "properties": {
                "type": { "type": "string" },
                "condition": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "retry_limit": { "type": "integer", "minimum": 0 },
          "timeout_minutes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "gate_rules": {
      "type": "object",
      "description": "What each gate outcome does to the pipeline. Declared here so the routing is inspectable config (C2) rather than control flow buried in a hook. Keys are outcome names, values are the action taken.",
      "additionalProperties": {
        "type": "string",
        "enum": ["pause", "halt_for_human", "loop_to_analysis", "loop_to_implementation", "loop_to_test", "continue"]
      }
    },
    "retry_policy": {
      "type": "object",
      "properties": {
        "max_cycles": { "type": "integer", "minimum": 1 },
        "backoff_seconds": { "type": "integer", "minimum": 0 },
        "on_failure": { "type": "string" }
      }
    }
  }
}
